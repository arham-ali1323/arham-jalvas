# MARK LIV web app — example environment. Copy to .env.local for development.

# Server-only: base URL of the FastAPI backend (services/api).
# Never exposed to the browser; all REST calls are proxied through /api.
API_BASE_URL=http://localhost:8080

# Public: the browser opens the live-voice WebSocket directly against the
# backend (a Next.js route handler cannot hold a long-lived socket). Set this to
# the backend's ws:// or wss:// origin. If omitted it is derived from
# NEXT_PUBLIC_API_BASE_URL. Local development falls back to localhost; production
# must set this or NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_WS_URL=ws://localhost:8080

# Public: backend origin, used only to derive the WebSocket URL in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public: shown in the UI.
NEXT_PUBLIC_APP_NAME=MARK LIV
