# MARK LIV backend — example environment. Copy to .env and fill in.
# NEVER commit the real .env.

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (no server needed):
DATABASE_URL=sqlite+aiosqlite:///./mark_liv_dev.db
# Production (managed PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mark_liv

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=gemini               # gemini | none
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ── Live voice ───────────────────────────────────────────────────────────────
# The real-time speech-to-speech model. The key above is used server-side only;
# browsers never receive it (they get a short-lived WebSocket ticket instead).
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
LIVE_VOICE_NAME=Charon           # Charon | Puck | Kore | Fenrir | Aoede
# Optional override for the spoken persona. Blank uses the built-in prompt.
LIVE_SYSTEM_INSTRUCTION=
LIVE_TICKET_TTL_SECONDS=60
LIVE_MAX_CONCURRENT_SESSIONS=4
LIVE_CONNECT_ATTEMPTS_PER_MINUTE=12

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of web origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000

# ── Password reset email ─────────────────────────────────────────────────────
EMAIL_BACKEND=console            # console (dev) | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Replace the .local sender with a sender address accepted by your mail provider
# before production.
SMTP_FROM=no-reply@mark-liv.local
SMTP_USE_TLS=true
WEB_APP_URL=http://localhost:3000
