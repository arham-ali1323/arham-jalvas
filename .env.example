# Root Compose environment. Copy to .env for local Docker development.
# Replace these placeholders with strong, unique values before deployment.

ENVIRONMENT=development
POSTGRES_PASSWORD=
JWT_SECRET=

# Gemini features return an explicit unavailable response when this is blank.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Browser origins. For production, list only the exact HTTPS website origin.
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Password-reset delivery. Console is development-only; production requires SMTP.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Replace the .local sender with a sender address accepted by your mail provider
# before production.
SMTP_FROM=no-reply@mark-liv.local
SMTP_USE_TLS=true

# Browser-facing values are embedded into the web bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_NAME=MARK LIV
